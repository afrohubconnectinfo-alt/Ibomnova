<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ibomnova - Create with AI</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
body{background:#fcfcfd;color:#111;display:flex;flex-direction:column;min-height:100vh}
header{display:flex;justify-content:space-between;align-items:center;padding:16px 24px;border-bottom:1px solid #eee;background:#fff;position:sticky;top:0;z-index:10}
.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:22px}
.logo span.badge{background:#111;color:#fff;font-size:10px;padding:2px 6px;border-radius:999px;margin-left:4px}
.nav{display:flex;gap:16px;align-items:center}
.nav a{text-decoration:none;color:#555;font-size:14px;font-weight:500}
.btn-primary{background:#111;color:#fff;padding:8px 16px;border-radius:999px;border:none;cursor:pointer;font-weight:600}
.hero{text-align:center;padding:60px 20px 30px}
.hero h1{font-size:48px;font-weight:800;line-height:1.1;letter-spacing:-2px}
.hero h1 .muted{color:#9ca3af}
.hero p{color:#6b7280;margin-top:16px;font-size:16px}
.tabs{display:flex;justify-content:center;gap:8px;margin:24px auto;background:#f3f4f6;padding:6px;border-radius:999px;width:fit-content}
.tab{padding:8px 20px;border-radius:999px;border:none;cursor:pointer;font-weight:600;background:transparent;color:#6b7280}
.tab.active{background:#111;color:#fff}
.workspace{max-width:800px;width:100%;margin:0 auto;padding:20px;flex:1}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:16px;box-shadow:0 1px 2px rgba(0,0,0,0.05)}
#messages{height:360px;overflow-y:auto;display:flex;flex-direction:column;gap:12px;margin-bottom:16px}
.msg{padding:10px 14px;border-radius:14px;max-width:80%;font-size:14px;line-height:1.5}
.msg.user{background:#111;color:#fff;align-self:flex-end}
.msg.ai{background:#f3f4f6;color:#111;align-self:flex-start}
.input-row{display:flex;gap:8px}
.input-row input{flex:1;padding:12px 16px;border-radius:999px;border:1px solid #e5e7eb;outline:none}
.hint{font-size:12px;color:#9ca3af;text-align:center;margin-top:12px}
footer{text-align:center;padding:24px;color:#9ca3af;font-size:12px;border-top:1px solid #eee;margin-top:40px}
.secure-badge{display:inline-flex;align-items:center;gap:6px;background:#ecfdf5;color:#065f46;padding:4px 10px;border-radius:999px;font-size:12px;margin-top:12px}
</style>
</head>
<body>
<header>
<div class="logo">ibomnova <span class="badge">AI</span></div>
<div class="nav"><a href="#">Pricing</a><button class="btn-primary">Sign in</button></div>
</header>
<div class="hero">
<h1>Create with <span class="muted">AI</span></h1>
<p>Chat, generate videos & images — secure & fast.</p>
<div class="secure-badge">🔒 Secured - API keys hidden on server</div>
<div class="tabs">
<button class="tab active" data-tab="chat">Chat</button>
<button class="tab" data-tab="video">Video</button>
<button class="tab" data-tab="image">Image</button>
</div>
</div>
<div class="workspace">
<div class="card">
<div id="messages"><div class="msg ai">Hello! I'm Ibomnova. Ask me anything. Your API keys are safe.</div></div>
<div class="input-row"><input id="input" placeholder="Ask Ibomnova anything..."><button class="btn-primary" id="send">Send</button></div>
<div class="hint">Example: Write a business plan for my fashion store</div>
</div>
</div>
<footer>© 2026 Ibomnova. Built securely - No secrets exposed.</footer>
<script>
const messagesEl=document.getElementById('messages'),inputEl=document.getElementById('input'),sendBtn=document.getElementById('send');let currentTab='chat';
document.querySelectorAll('.tab').forEach(t=>{t.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));t.classList.add('active');currentTab=t.dataset.tab;});});
async function send(){const text=inputEl.value.trim();if(!text)return;addMsg(text,'user');inputEl.value='';addMsg('Thinking...','ai','temp');try{const res=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text,type:currentTab})});const data=await res.json();document.querySelector('.msg.temp')?.remove();if(data.reply)addMsg(data.reply,'ai');else addMsg('Error: '+data.error,'ai');}catch(e){document.querySelector('.msg.temp')?.remove();addMsg('Connection error. Deploy api folder first.','ai');}}
function addMsg(txt,who,extra=''){const d=document.createElement('div');d.className='msg '+who+' '+extra;d.textContent=txt;messagesEl.appendChild(d);messagesEl.scrollTop=messagesEl.scrollHeight;}
sendBtn.onclick=send;inputEl.addEventListener('keydown',e=>{if(e.key==='Enter')send();});
</script>
</body>
</html>
